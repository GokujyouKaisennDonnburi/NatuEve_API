{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
