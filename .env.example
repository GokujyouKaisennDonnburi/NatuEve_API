# このファイルはローカル開発用のテンプレート。コピーして .env を作る（cp .env.example .env）。
# 本番では .env を使わず、実行環境の環境変数やシークレットマネージャで値を注入する。

# サーバの待ち受けポート（未設定なら 8085）
PORT=8085

# 信頼するプロキシ（カンマ区切りの CIDR/IP）。未設定なら全プロキシを信頼しない。
# 開発: 未設定でOK（直接接続）
# 本番: 使わない（利用者 IP は中継用 Worker が渡すヘッダーから読む。下記 RELAY_CLIENT_IP_HEADER、ADR-0034）
# TRUSTED_PROXIES=

# --- 中継元の確認（中継用 Worker の秘密ヘッダー。ADR-0034）---
# RELAY_SECRET と RELAY_CLIENT_IP_HEADER を両方設定すると、全リクエストで秘密ヘッダー X-Relay-Auth の値を確かめ、
# 一致しなければ 403 を返す（/health と /internal/outbox/process は除く）。
# 確認に通ったリクエストに限り、利用者 IP（IP レート制限・ログ）を RELAY_CLIENT_IP_HEADER の値から読む。
# 片方だけの設定、RELAY_SECRET_PREVIOUS だけの設定、32 バイト未満の値では起動しない。
# 開発: 未設定でOK（確認しない）
# 本番: 秘密値は Secret Manager から注入し、workers/api-relay の RELAY_SECRET と同じ値にする（生成例: openssl rand -hex 32）
# RELAY_SECRET=
# 値の差し替え中だけ、古い値を設定する（手順は docs/Deployment.md）
# RELAY_SECRET_PREVIOUS=
# 利用者 IP を入れるヘッダー名。workers/api-relay/wrangler.jsonc の CLIENT_IP_HEADER と同じ値にする
# RELAY_CLIENT_IP_HEADER=X-NatuEve-Client-IP

# CORS で許可するオリジン（カンマ区切り）。未設定なら http://localhost:3000,http://localhost:8787
# （フロントの next dev と、Workers ランタイムの preview の既定ポート）。
# 各値は scheme://host[:port] の形で書く（末尾スラッシュ・パス・* は不可。不正な値があると起動しない）。
# 開発: 未設定でOK（フロントを上記以外のオリジンで動かす場合のみ設定。127.0.0.1 は localhost と別オリジン扱い）
# 本番: 本番のフロントのオリジンを設定（例: https://natuibe.example.com）
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8787

# --- データベース ---
# Postgres 接続文字列。未設定なら DB に接続せず起動する。
# docker compose 起動時は compose 側で自動設定されるため未設定でOK。
# ローカルで直接 Postgres に繋ぐ場合に設定する:
# DATABASE_URL=postgres://app:app@localhost:5432/NatuEve?sslmode=disable

# 1 プロセスあたりの DB 接続数の上限（ADR-0037）。未設定なら上限なし（起動時に警告ログを出す）。
# 2 以上の整数を指定する（整数でない値・2 未満の値では起動しない）。
# DATABASE_URL が未設定のときは値を検証しない。
# 開発: 未設定でOK（警告ログが出るが、上限なしで動く）
# 本番: 6（Supabase のプールの上限から決める。docs/Deployment.md）
# DB_MAX_OPEN_CONNS=

# 起動時にマイグレーションを自動適用するか（開発用）。
# 本番では false にし、デプロイ手順で `make migrate-up GOOSE_EXEC='sh -c'` を実行する（compose 外なのでホスト実行）。
# DB_AUTO_MIGRATE=false

# --- 認証（Supabase Auth の JWT を JWKS で検証する） ---
# Supabase の JWKS エンドポイント。
# 設定すると user 関連 API（/api/v1/me など）が有効になる。未設定なら登録しない。
# 例: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=

# 検証時に要求する JWT の aud クレーム。未設定なら "authenticated"（Supabase 既定）。
# SUPABASE_JWT_AUD=authenticated

# --- ストレージ（Cloudflare R2）---
# R2 の S3 互換 API 認証情報。設定すると presign エンドポイントと画像/PDF 昇格が有効になる。
# 未設定なら storage 系ルートは登録しない（JWKS gating と同じ方針）。
# Cloudflare ダッシュボード > R2 > API トークン から取得する。
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# バケット名（未設定なら "natuportal"）
# R2_BUCKET=natuportal
# 公開バケットの配信ベースURL（R2 パブリックバケット or カスタムドメイン）。
# 設定すると events 等のレスポンスに imageUrls/pdfUrls（完全URL）を含める。未設定なら URL は付与しない。
# 末尾スラッシュは有無どちらでもよい。今は本番と同じ値（#247 で開発用のドメインに切り替える）。
# フロントの next.config.ts の images.remotePatterns に無いホストにすると、フロントで画像が表示されない。
# R2_PUBLIC_BASE_URL=https://assets.natuportal.org

# --- メール送信（Resend）---
# Resend の API キー。設定するとイベント参加者への一斉送信エンドポイントが有効になる。
# 未設定なら通知系ルートは登録しない（R2 の gating と同じ方針）。
# RESEND_API_KEY=
# 送信元メールアドレス。
# 例: notify@notify.natuibe.app
# MAIL_FROM=

# --- 通知メールの outbox 処理 ---
# true にすると、API プロセス内で 30 秒間隔に outbox を処理する常駐ワーカーを起動する（ローカル開発用）。
# 本番は Cloud Scheduler が POST /internal/outbox/process を呼ぶため設定しない（ADR-0035）。
# RESEND_API_KEY と MAIL_FROM も設定されている場合にだけ動く。
OUTBOX_WORKER_ENABLED=true
# Cloud Scheduler の OIDC トークンの audience と、ジョブが使うサービスアカウントのメールアドレス。
# 両方設定すると POST /internal/outbox/process が有効になる。ローカルでは通常は不要。
# SCHEDULER_OIDC_AUDIENCE=
# SCHEDULER_SERVICE_ACCOUNT_EMAIL=
